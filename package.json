{
  "name": "siaas-personal",
  "version": "1.0.0",
  "description": "SIAAS Personal \u2014 local-first AI assistants with isolated knowledge",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.cjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:chat": "node tests/chat-api.mjs",
    "ollama:check": "node --import tsx scripts/check-ollama.ts",
    "ollama:test": "node --import tsx scripts/test-ollama.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "node scripts/desktop.mjs",
    "desktop:install": "npm ci && npx --no-install install-electron --no && npm run desktop:build",
    "test:desktop": "node tests/desktop-e2e.mjs",
    "desktop:prepare": "node scripts/prepare-package.mjs",
    "desktop:package": "npm run desktop:build && npm run desktop:prepare && electron-builder --config electron-builder.cjs --publish never",
    "test:installer": "node --test tests/installer.test.cjs",
    "test:package": "node tests/package-smoke.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "desktop:dev": "npm run desktop:build && npm run desktop",
    "test:projects": "node tests/project-flows.mjs",
    "research:setup": "node scripts/research-services.mjs setup",
    "research:start": "node scripts/research-services.mjs start",
    "research:stop": "node scripts/research-services.mjs stop",
    "research:status": "node scripts/research-services.mjs status",
    "test:research": "node --import tsx --test tests/research*.test.ts tests/morphic.test.mjs tests/morphic-http.test.mjs tests/research-lifecycle.test.mjs tests/docker-prerequisites.test.mjs",
    "templates:sync": "node scripts/sync-templates.mjs",
    "templates:check": "node scripts/sync-templates.mjs --check",
    "prebuild": "npm run templates:check",
    "predesktop:build": "npm run templates:check",
    "test:knowledge": "node tests/knowledge-api.mjs",
    "release:source": "node scripts/release-source.mjs",
    "test:distribution": "node --test tests/distribution.test.mjs tests/docker-prerequisites.test.mjs tests/source-manager.test.mjs",
    "test:experimental": "node --import tsx --test tests/experimental*.test.ts tests/docker-prerequisites.test.mjs",
    "test:actions": "node --import tsx --test tests/actions.test.ts",
    "test:actions:api": "node tests/actions-api.mjs",
    "test:actions:ui": "node tests/actions-ui.mjs",
    "test:structured": "node --import tsx --test tests/structured.test.ts",
    "test:structured:api": "node tests/structured-api.mjs",
    "test:structured:ui": "node tests/structured-api.mjs --ui"
  },
  "keywords": [],
  "author": "Davide Abbatiello",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@langchain/core": "1.2.17",
    "@langchain/ollama": "1.3.0",
    "decimal.js": "10.6.0",
    "electron-updater": "6.6.2",
    "exceljs": "4.4.0",
    "langchain": "1.5.16",
    "lucide-react": "1.49.0",
    "mammoth": "1.13.0",
    "next": "16.3.8",
    "papaparse": "5.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "unpdf": "1.8.1",
    "yauzl": "3.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "extract-zip": "2.0.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siaas-software/siaas-personal.git"
  },
  "homepage": "https://siaas.vercel.app",
  "bugs": {
    "url": "https://github.com/siaas-software/siaas-personal/issues"
  }
}
