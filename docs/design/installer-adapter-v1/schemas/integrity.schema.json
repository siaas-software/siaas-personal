{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.siaas.invalid/installer-adapter/1.0/integrity.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "installationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "transactionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "target": {
      "$ref": "https://schemas.siaas.invalid/installer-adapter/1.0/common.schema.json#/$defs/target"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "runtimeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "lockfileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "buildPolicySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.(0|[1-9][0-9]*))?$(?![\\s\\S])"
        },
        "npm": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.(0|[1-9][0-9]*))?$(?![\\s\\S])"
        },
        "builder": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.(0|[1-9][0-9]*))?$(?![\\s\\S])"
        }
      },
      "required": [
        "node",
        "npm",
        "builder"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
              },
              "type": {
                "const": "file"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
              },
              "executable": {
                "type": "boolean"
              },
              "mode": {
                "type": "string",
                "pattern": "^[0-7]{4}$(?![\\s\\S])"
              }
            },
            "required": [
              "path",
              "type",
              "size",
              "sha256",
              "executable",
              "mode"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
              },
              "type": {
                "const": "directory"
              },
              "mode": {
                "type": "string",
                "pattern": "^[0-7]{4}$(?![\\s\\S])"
              }
            },
            "required": [
              "path",
              "type",
              "mode"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
              },
              "type": {
                "const": "symlink"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
              }
            },
            "required": [
              "path",
              "type",
              "target"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "ownership": {
      "type": "object",
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aclSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "signaturePolicySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "principal",
        "aclSha256",
        "signaturePolicySha256"
      ],
      "additionalProperties": false
    },
    "launcher": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "transactionId",
    "generation",
    "target",
    "sourceSha256",
    "runtimeSha256",
    "lockfileSha256",
    "buildPolicySha256",
    "toolchain",
    "files",
    "ownership",
    "launcher",
    "profile"
  ],
  "additionalProperties": false
}
