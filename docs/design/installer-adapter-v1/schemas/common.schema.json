{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.siaas.invalid/installer-adapter/1.0/common.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\:\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
    },
    "target": {
      "type": "object",
      "properties": {
        "product": {
          "const": "siaas-personal"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc\\.(0|[1-9][0-9]*))?$(?![\\s\\S])"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
        },
        "channel": {
          "enum": [
            "stable",
            "candidate"
          ]
        },
        "platform": {
          "enum": [
            "linux",
            "win32",
            "darwin"
          ]
        },
        "arch": {
          "enum": [
            "x64",
            "arm64"
          ]
        }
      },
      "required": [
        "product",
        "version",
        "commit",
        "channel",
        "platform",
        "arch"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "const": "stable"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$(?![\\s\\S])"
              }
            }
          },
          "else": {
            "properties": {
              "version": {
                "type": "string",
                "pattern": "-rc\\.\\d+$(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "paths": {
      "type": "object",
      "properties": {
        "installRoot": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        },
        "launcher": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "desktop-entry",
                "cmd",
                "command"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 2,
              "maxLength": 4096,
              "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        "profile": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        },
        "receipt": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        }
      },
      "required": [
        "installRoot",
        "launcher",
        "profile",
        "receipt"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capability": {
      "enum": [
        "install-only",
        "explicit-paths",
        "isolated-channels",
        "durable-receipts",
        "installed-integrity",
        "journal-recovery",
        "prepared-archives",
        "build-network-consent"
      ]
    }
  }
}
