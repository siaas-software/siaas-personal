{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.siaas.invalid/installer-adapter/1.0/journal.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "installationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "transactionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "target": {
      "$ref": "https://schemas.siaas.invalid/installer-adapter/1.0/common.schema.json#/$defs/target"
    },
    "paths": {
      "$ref": "https://schemas.siaas.invalid/installer-adapter/1.0/common.schema.json#/$defs/paths"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "baseActiveGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previousRecordSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "event": {
      "enum": [
        "intent",
        "done"
      ]
    },
    "step": {
      "enum": [
        "validate",
        "copy",
        "build",
        "prepare",
        "commit",
        "gate-install",
        "launcher",
        "pointer",
        "verify",
        "activate",
        "gate-release",
        "restore",
        "receipt"
      ]
    },
    "lastDurableState": {
      "enum": [
        "none",
        "prepared",
        "committed",
        "activated"
      ]
    },
    "owner": {
      "type": "object",
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "processStartIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "lockNonce": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"
        }
      },
      "required": [
        "principal",
        "processStartIdentity",
        "lockNonce"
      ],
      "additionalProperties": false
    },
    "installedManifestSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "backups": {
      "type": "object",
      "properties": {
        "launcher": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 4096,
                  "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
                },
                "backupPath": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 4096,
                  "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                }
              },
              "required": [
                "path",
                "backupPath",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "pointer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 4096,
                  "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
                },
                "backupPath": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 4096,
                  "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                }
              },
              "required": [
                "path",
                "backupPath",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "dispatcher": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 4096,
                  "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
                },
                "backupPath": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 4096,
                  "pattern": "^(?:/|[A-Za-z]:\\\\)[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                }
              },
              "required": [
                "path",
                "backupPath",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "launcher",
        "pointer",
        "dispatcher"
      ],
      "additionalProperties": false
    },
    "receiptSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "https://schemas.siaas.invalid/installer-adapter/1.0/common.schema.json#/$defs/path"
        },
        "sha256": {
          "$ref": "https://schemas.siaas.invalid/installer-adapter/1.0/common.schema.json#/$defs/sha256"
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "transactionId",
    "requestSha256",
    "target",
    "paths",
    "baseRevision",
    "baseActiveGeneration",
    "generation",
    "sequence",
    "previousRecordSha256",
    "operationId",
    "event",
    "step",
    "lastDurableState",
    "owner",
    "installedManifestSha256",
    "backups",
    "receiptSha256",
    "requestSnapshot"
  ],
  "additionalProperties": false
}
