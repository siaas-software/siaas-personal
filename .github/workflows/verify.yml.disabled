name: Verify desktop source
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: verify-${{ github.ref }}
  cancel-in-progress: true
jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: npm
      - name: Install locked dependencies
        run: npm ci
      - name: Check TypeScript
        run: npm run typecheck
      - name: Run automated tests
        run: npm test
      - name: Verify template snapshot
        run: npm run templates:check
      - name: Build desktop server
        run: npm run desktop:build
      - name: Verify account-free source
        shell: bash
        run: |
          if grep -R -n -E '@supabase/|DesktopAccount|auth/v1/token' desktop src --include='*.cjs' --include='*.ts' --include='*.tsx'; then
            echo "Obsolete authentication integration remains."
            exit 1
          fi
